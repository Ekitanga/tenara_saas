# Copy to .env for local development. Never commit real values.
SECRET_KEY=replace-with-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
CORE_PRODUCT_MODE=True
ENABLE_SUBSCRIPTIONS=False
ENABLE_REMINDERS=False
ENABLE_MPESA=False
ENABLE_SMS=False

# Production database (required when DEBUG=False)
# Managed hosts such as Render can provide this single variable.
DATABASE_URL=
DB_NAME=tenara_db
DB_USER=tenara
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Transactional email (required for password reset in production)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# Redis/Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
